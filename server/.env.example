# Copy to .env to override defaults (optional).
# The server runs an embedded MongoDB by default — no MongoDB install needed.

# HTTP port for the API
PORT=5000

# Use a real MongoDB instance instead of the embedded one
# MONGODB_URI=mongodb://localhost:27017/oasbay

# Data directory for the embedded MongoDB (persists across restarts)
# DB_PATH=/home/emma-derrick/Desktop/website.1/server/.data/db

# MongoDB binary version downloaded by mongodb-memory-server
# MONGOMS_VERSION=7.0.14
